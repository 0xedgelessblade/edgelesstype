+        sparams.hostname = "127.0.0.1";
+        svr->set_pre_routing_handler([session_token](const Request & req, Response & res) {
+            if (req.get_header_value("X-OpenTypeless-Session") != session_token) {
+                res.status = 403;
+                return Server::HandlerResponse::Handled;
+            }
+            if (req.path != "/health" && req.path != "/inference") {
+                res.status = 404;
+                return Server::HandlerResponse::Handled;
+            }
+            return Server::HandlerResponse::Unhandled;
+        });
+    }
