+    // OpenTypeless: private loopback service, owned by one app process.
+    // The random per-launch token is inherited in memory, never persisted.
+    const char * token_env = std::getenv("OPEN_TYPELESS_SESSION_TOKEN");
+    const std::string session_token = token_env ? token_env : "";
